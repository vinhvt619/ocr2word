# Vercel Blob (được tự thêm khi connect Private Blob store)
BLOB_READ_WRITE_TOKEN=
# Private Blob mới có thể dùng OIDC thay cho token tĩnh.
BLOB_STORE_ID=

# Upstash Redis (tên biến trực tiếp từ Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace có thể cấp cặp biến tương đương này thay thế.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Tự tạo hai chuỗi ngẫu nhiên khác nhau, không commit giá trị thật.
OCR2WORD_INTERNAL_SECRET=
CRON_SECRET=

# Gemini cho local, Preview và Production
GEMINI_API_KEY=
OCR2WORD_AI_MODEL=gemini-3.7-flash
OCR2WORD_QUEUE_REGION=sin1
